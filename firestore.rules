rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/state/{stateId} {
      function ownsData() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, delete: if ownsData() && stateId == 'app';
      allow create, update: if ownsData()
        && stateId == 'app'
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'updatedAt',
          'document'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.document is map;
    }
  }
}
